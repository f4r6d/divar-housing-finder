{
  "name": "divar-housing-finder",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute divar-housing-db --remote --file=./schema.sql",
    "db:seed": "wrangler d1 execute divar-housing-db --remote --file=./seed/seed-districts.sql",
    "db:init-local": "wrangler d1 execute divar-housing-db --local --file=./schema.sql",
    "db:seed-local": "wrangler d1 execute divar-housing-db --local --file=./seed/seed-districts.sql",
    "db:console": "wrangler d1 execute divar-housing-db --remote --command \"SELECT id, title, fake_label FROM listings ORDER BY scraped_at DESC LIMIT 10\""
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}